# ============================================
# ISKCON Spiritual Bot — Environment Variables
# ============================================
# Copy this file as .env and fill your values
# NEVER commit .env to GitHub

# Anthropic Claude API key
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL + pgvector
# Local: postgresql://postgres:password@localhost:5432/iskcon_bot
# Railway: auto-filled when you add PostgreSQL plugin
DATABASE_URL=postgresql://postgres:password@localhost:5432/iskcon_bot

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-any-random-string
PORT=5000

# iskconbooks.in base URL
ISKCON_BOOKS_URL=https://iskconbooks.in

# Bot tuning
BOT_MAX_TOKENS=1024
RETRIEVE_TOP_K=4
